; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Monster Catching Game"
run/main_scene="res://game/boot/splash.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

Logging="*res://game/autoload/logging.gd"
DialogueManager="*res://addons/dialogue_manager/dialogue_manager.gd"
DataRegistry="*res://game/autoload/data_registry.gd"
Settings="*res://game/autoload/settings.gd"
GameState="*res://game/autoload/game_state.gd"
SceneRouter="*res://game/autoload/scene_router.gd"
Story="*res://game/autoload/story.gd"
Cutscene="*res://game/autoload/cutscene.gd"
AchievementService="*res://game/autoload/achievement_service.gd"
DebugMenu="*res://game/debug/debug_menu.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[dotnet]

project/assembly_name="Monster Catching Game"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_manager/plugin.cfg", "res://addons/gdUnit4/plugin.cfg")

[internationalization]

locale/translations_pot_files=PackedStringArray("res://dialogue/route_01/rival_intro.dialogue", "res://dialogue/route_01/minigame.dialogue", "res://dialogue/route_01/npcs.dialogue", "res://dialogue/route_01/tamers.dialogue", "res://dialogue/common/heal.dialogue", "res://dialogue/town_01/npcs.dialogue", "res://dialogue/town_01/story.dialogue", "res://tests/fixtures/test_talk.dialogue")

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
