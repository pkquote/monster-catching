class_name LocationDef
extends RefCounted
## A map's wild encounter tables, from data/locations.json (generated by tools/build_locations.tscn).

var id: String
var name: String
## Encounter table ids: the map's default table first, then each encounter area's.
var areas: PackedStringArray


static func from_dict(d: Dictionary) -> LocationDef:
	var l := LocationDef.new()
	l.id = d.id
	l.name = d.name
	l.areas = PackedStringArray(d.areas)
	return l
